{
  "name": "fixture-gen",
  "version": "1.4.1",
  "description": "Schema-agnostic, deterministic test fixtures for any Standard Schema validator.",
  "type": "module",
  "license": "MIT",
  "author": "Alireza Arjvand",
  "keywords": [
    "fixture",
    "test-fixtures",
    "mock",
    "mock-data",
    "faker",
    "deterministic",
    "standard-schema",
    "zod",
    "valibot",
    "arktype",
    "typebox",
    "testing",
    "vitest",
    "jest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjvand/fixture-gen.git"
  },
  "workspaces": [".", "packages/*"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "bin": {
    "fixture-gen": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/cross-validator.test.ts",
    "test:compat": "vitest run test/cross-validator.test.ts",
    "test:runtime": "bash scripts/runtime-smoke.sh",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "docs:api": "node scripts/generate-api.mjs",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "size": "size-limit",
    "check": "npm run lint && npm run typecheck --workspaces --include-workspace-root && npm run build --workspaces --include-workspace-root && npm run size && npm run test:runtime && npm test",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "20 kB"
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@edge-runtime/vm": "^5.0.0",
    "@sinclair/typebox": "^0.34.49",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^25.9.1",
    "arktype": "^2.2.0",
    "size-limit": "^12.1.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.11",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "valibot": "^1.4.1",
    "@changesets/cli": "^2.28.1",
    "vitepress": "^1.6.3",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "zod": "^4.4.3"
  }
}
