{
  "name": "fixture-gen",
  "version": "1.1.0",
  "description": "Schema-agnostic, deterministic test fixtures for any Standard Schema validator.",
  "type": "module",
  "license": "MIT",
  "author": "Alireza Arjvand",
  "keywords": [
    "fixture",
    "test-fixtures",
    "mock",
    "mock-data",
    "faker",
    "deterministic",
    "standard-schema",
    "zod",
    "valibot",
    "arktype",
    "typebox",
    "testing",
    "vitest",
    "jest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arjvand/fixture-gen"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/cross-validator.test.ts",
    "test:compat": "vitest run test/cross-validator.test.ts",
    "test:runtime": "bash scripts/runtime-smoke.sh",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "docs:api": "node scripts/generate-api.mjs",
    "size": "size-limit",
    "check": "npm run lint && npm run typecheck && npm run build && npm run size && npm run test:runtime && npm test"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "20 kB"
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@edge-runtime/vm": "^5.0.0",
    "@sinclair/typebox": "^0.34.49",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^25.9.1",
    "arktype": "^2.2.0",
    "size-limit": "^12.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "valibot": "^1.4.1",
    "vitest": "^2.1.8",
    "zod": "^4.4.3"
  }
}
